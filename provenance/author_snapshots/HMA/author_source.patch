diff --git a/src/reference_eval.h b/src/reference_eval.h
new file mode 100644
index 0000000000000000000000000000000000000000..622ce10fb6ad4ef44ea82e9f2ea627c867d0d67a
--- /dev/null
+++ b/src/reference_eval.h
@@ -0,0 +1,65 @@
+#pragma once
+// Included after HMA's status declaration. The public benchmark verifier remains external.
+// Units: distance km; energy kWh; time seconds; capacity and delivery in the same volume unit.
+inline void reference_route_status(std::vector<int> &nl, std::vector<status> &sl,
+                                  Data &data, int &flag, double &cost,
+                                  int &negative_index, bool adjust_stations)
+{
+    reference_check_deadline();
+    const double eps = 1e-5; // canonical validate_routes tolerance
+    flag = 0; cost = double(INFINITY); negative_index = -1;
+    if (nl.size() < 2 || nl.front() != data.DC || nl.back() != data.DC) return;
+    for (size_t i=1;i+1<nl.size();++i) if (nl[i]==data.DC) return;
+    sl.resize(nl.size());
+    double load = 0.0, distance = 0.0, time = data.start_time;
+    int customers = 0;
+    for (int n : nl) {
+        if (n < 0 || n >= data.node_num) return;
+        load += data.node[n].delivery;
+        customers += data.node[n].type == 1;
+    }
+    if (load > data.vehicle.capacity + eps) { flag = 2; return; }
+    sl[0] = {time, time, data.max_distance_reachable, data.max_distance_reachable};
+    for (size_t i=1; i<nl.size(); ++i) {
+        int previous = nl[i-1], node = nl[i];
+        double remaining = sl[i-1].dep_RD - data.energy_distance(previous,node);
+        // Preserve the author's bounded station replacement rule in its evolution path.
+        if (adjust_stations && data.node[node].type == 2 && i+1 < nl.size()) {
+            auto segment_distance = [&](int candidate) {
+                double d = data.energy_distance(candidate,nl[i+1]);
+                size_t j = i+1;
+                while (data.node[nl[j]].type == 1 && j+1 < nl.size()) {
+                    d += data.energy_distance(nl[j],nl[j+1]); ++j;
+                }
+                return d;
+            };
+            if (remaining < -eps || segment_distance(node) > data.max_distance_reachable + eps) {
+                for (int k=1; k<data.station_range; ++k) {
+                    int candidate = data.optimal_staion[previous][nl[i+1]][k];
+                    double candidate_remaining = sl[i-1].dep_RD - data.energy_distance(previous,candidate);
+                    if (candidate_remaining >= -eps && segment_distance(candidate) <= data.max_distance_reachable + eps) {
+                        node = candidate; nl[i] = candidate; remaining = candidate_remaining; break;
+                    }
+                }
+            }
+        }
+        time += data.time[previous][node];
+        sl[i].arr_time = time; sl[i].arr_RD = remaining;
+        if (data.node[node].type != 2 && std::max(time,data.node[node].start) > data.node[node].end + eps) { flag = 3; return; }
+        if (remaining < -eps) { flag = 4; negative_index = int(i); return; }
+        if (data.node[node].type != 2)
+            time = std::max(time, data.node[node].start) + data.node[node].s_time;
+        load -= data.node[node].delivery;
+        if (load < -eps || load > data.vehicle.capacity + eps) { flag = 2; return; }
+        if (data.node[node].type == 2) {
+            // Effective station power is already derated in the exported input, exactly once.
+            double added_kwh = std::max(0.0, (data.max_distance_reachable-remaining)*data.vehicle.consumption_rate);
+            time += added_kwh * data.charging_seconds_per_kwh.at(node);
+            sl[i].dep_RD = data.max_distance_reachable;
+        } else sl[i].dep_RD = remaining;
+        sl[i].dep_time = time;
+        distance += data.dist[previous][node];
+    }
+    flag = 1;
+    cost = (customers ? data.vehicle.d_cost : 0.0) + data.vehicle.unit_cost * distance;
+}
diff --git a/src/reference_runtime.cpp b/src/reference_runtime.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0ac26912572ac59e7b6d26d17ae3d651a4430c1a
--- /dev/null
+++ b/src/reference_runtime.cpp
@@ -0,0 +1,70 @@
+#include "solution.h"
+#include "reference_runtime.h"
+#include <cstdlib>
+#include <thread>
+#include <fstream>
+#include <iomanip>
+namespace {
+bool enabled=false;
+double started=0, budget=0, best=double(INFINITY);
+long emitted=0;
+std::string events_path, ack_path, stop_path;
+double monotonic_now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+std::string env(const char *name) { const char *x=std::getenv(name); return x?x:""; }
+}
+void reference_initialize(bool requested) {
+    enabled=requested;
+    if (!enabled) return;
+    started=env("HMA_START_MONOTONIC").empty()?monotonic_now():std::stod(env("HMA_START_MONOTONIC"));
+    budget=std::stod(env("HMA_BUDGET_S"));
+    if (!(budget>0)) throw std::runtime_error("HMA_BUDGET_S must be positive");
+    events_path=env("HMA_EVENTS_PATH"); ack_path=env("HMA_ACK_PATH"); stop_path=env("HMA_STOP_PATH");
+    if (events_path.empty()) throw std::runtime_error("HMA_EVENTS_PATH is required");
+}
+double reference_elapsed() { return enabled?monotonic_now()-started:0.0; }
+void reference_check_deadline() { if (enabled && reference_elapsed()>=budget) throw ReferenceDeadline(); }
+clock_t reference_clock() { return enabled?clock_t(reference_elapsed()*CLOCKS_PER_SEC):std::clock(); }
+void reference_finish(const char *reason) {
+    if (!enabled || stop_path.empty()) return;
+    std::ofstream out(stop_path);
+    out<<std::setprecision(17)<<"{\"stop_reason\":\""<<reason<<"\",\"elapsed_s\":"<<reference_elapsed()
+       <<",\"budget_s\":"<<budget<<",\"candidate_count\":"<<emitted<<"}\n";
+}
+void reference_emit_candidate(Solution &s, Data &data, const char *stage, bool customer_lists) {
+    if (!enabled || data.is_subproblem || !std::isfinite(s.cost) || !(s.cost<best-1e-9)) return;
+    reference_check_deadline();
+    // Native consistency gate only: external canonical verification determines final feasibility and cost.
+    std::vector<std::vector<int>> routes;
+    std::vector<int> counts(data.customer_num+1,0);
+    double evaluated=0.0;
+    for (int i=0; i<s.len(); ++i) {
+        Route &r=s.get(i);
+        std::vector<int> nl=customer_lists?r.customer_list:r.node_list;
+        bool serves=false;
+        for (int n:nl) if (n>=1 && n<=data.customer_num) { serves=true; ++counts[n]; }
+        if (!serves) continue;
+        std::vector<status> states; int flag=0,negative=-1; double cost=0;
+        reference_route_status(nl,states,data,flag,cost,negative,false);
+        if (flag!=1) return;
+        evaluated+=cost; routes.push_back(nl);
+    }
+    for (int i=1;i<=data.customer_num;++i) if (counts[i]!=1) return;
+    if (std::abs(evaluated-s.cost)>1e-5) return; // never publish a stale or penalty objective as a feasible incumbent
+    reference_check_deadline();
+    double elapsed=reference_elapsed();
+    std::ofstream out(events_path,std::ios::app);
+    if (!out) throw std::runtime_error("Cannot append HMA candidate journal");
+    out<<std::setprecision(17)<<"{\"elapsed_s\":"<<elapsed<<",\"internal_objective\":"<<s.cost
+       <<",\"stage\":\""<<stage<<"\",\"routes\":[";
+    for (size_t i=0;i<routes.size();++i) { if(i)out<<",";out<<"[";
+        for(size_t j=0;j<routes[i].size();++j){if(j)out<<",";out<<routes[i][j];}out<<"]"; }
+    out<<"]}\n"; out.flush();
+    if (!out) throw std::runtime_error("Cannot flush HMA candidate journal");
+    best=s.cost; ++emitted;
+    if (!ack_path.empty()) for (;;) {
+        reference_check_deadline();
+        std::ifstream ack(ack_path); long count=-1; ack>>count;
+        if (count>=emitted) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+}
